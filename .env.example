# Example environment to develop on Railgun API
# Please fill the empty values according to your workstation

# Application global settings
APP_NAME=railgun
APP_ENV=edge
APP_KEY=base64:aVVQR1o3TkNwckh6M1JvRzdBY2xVZWM0NVIzZWNZRTdOckpiRkdlNA== # change it!
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Application URLs
APP_URL=https://edge.mathrix.tech/graphql
ANGULAR_URL=https://mathrix.fr

# Database service, see config/database.php for details
DB_CONNECTION=mysql
DB_DATABASE=mathrix_education_local
DB_HOST=127.0.0.1
DB_PASSWORD=# must be provided
DB_USERNAME=# must be provided

# Logging
LOG_CHANNEL=google-cloud

# Cache service, see config/cache.php for details
CACHE_DRIVER=file
REDIS_HOST=

# Queue
QUEUE_DRIVER=redis

# Lighthouse
LIGHTHOUSE_CACHE_ENABLE=false

# Prometheus
PROMETHEUS_ADAPTER=redis
PROMETHEUS_REDIS_CONNECTION=prometheus

# Mailjet
MAILJET_KEY=f5a7b6ed480ad9d66afe108df2ddd1b5
MAILJET_SECRET=c8dfa643dac11ac902e098e4a9672c10
MAILJET_CALL=true

# Google Cloud service
GOOGLE_CLIENT_ID=
GOOGLE_CLOUD_PROJECT_ID=mathrix-education
GOOGLE_CLOUD_STORAGE_BUCKET=dev.cdn.mathrix.fr

# Facebook Application
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_APP_TOKEN=

# Stripe Payments
STRIPE_SECRET=
STRIPE_WEBHOOKS_SECRET=

# Sentry
SENTRY_DSN=
