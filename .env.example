# Example environment to develop on Railgun API
# Please fill the empty values according to your workstation

# Application global settings
APP_NAME=railgun
APP_ENV=v7
APP_KEY=base64:aVVQR1o3TkNwckh6M1JvRzdBY2xVZWM0NVIzZWNZRTdOckpiRkdlNA== # change it!
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Application URLs
APP_URL=https://v7.api.mathrix.fr
ANGULAR_URL=https://v7.mathrix.fr
CDN_URL=https://dev.cdn.mathrix.fr

# Database service, see config/database.php for details
DB_CONNECTION=mysql
DB_DATABASE=mathrix_education_local
DB_HOST=127.0.0.1
DB_PASSWORD=# must be provided
DB_USERNAME=# must be provided

# Logging
LOG_CHANNEL=stackdriver

# Cache service, see config/cache.php for details
CACHE_DRIVER=file
REDIS_HOST=

# Queue
QUEUE_DRIVER=sync

# Google Cloud service
GOOGLE_CLOUD_PROJECT_ID=mathrix-education
GOOGLE_CLOUD_STORAGE_BUCKET=dev.cdn.mathrix.fr

# Facebook Application
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_APP_TOKEN=

# Google Client API
GOOGLE_CLIENT_ID=

# Braintree Payments
BRAINTREE_ENVIRONMENT=sandbox
BRAINTREE_MERCHANT_ACCOUNT=
BRAINTREE_MERCHANT_ID=
BRAINTREE_PRIVATE_KEY=
BRAINTREE_PUBLIC_KEY=

# Stripe Payments
STRIPE_SECRET=
STRIPE_WEBHOOKS_SECRET=

# Sentry
SENTRY_DSN=
