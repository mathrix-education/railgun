<?xml version="1.0"?>
<!-- PHP_CodeSniffer global configuration file -->
<ruleset
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    name="Mathrix Eucation API"
    xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd"
>
    <description>The coding standard of Mathrix Education API.</description>

    <!-- Arguments -->
    <arg value="p"/>
    <arg name="basepath" value="."/>
    <arg name="cache" value="storage/framework/cache/data/phpcs.json"/>
    <arg name="colors"/>
    <arg name="parallel" value="75"/>
    <arg name="severity" value="1"/>

    <!-- Inclusions -->
    <file>app</file>
    <file>bootstrap</file>
    <file>config</file>
    <file>database</file>

    <!-- Rules inherited from Doctrine -->
    <rule ref="Doctrine">
        <exclude name="Generic.Formatting.SpaceAfterNot"/>
        <exclude name="Generic.Formatting.SpaceAfterCast"/>
        <exclude name="Squiz.Strings.DoubleQuoteUsage.ContainsVar"/>
        <exclude name="SlevomatCodingStandard.Exceptions.ReferenceThrowableOnly"/>
    </rule>

    <!-- Force no whitespace after a type cast -->
    <rule ref="Generic.Formatting.NoSpaceAfterCast"/>
</ruleset>
