<mjml>
    <mj-include path="../common/head"></mj-include>

    <mj-body>
        <mj-container>
            <mj-include path="../common/header"></mj-include>

            <mj-section background-color="#ffffff">
                <mj-column>
                    <mj-text height="20"
                             padding="0"
                             align="center"
                             font-size="18px"
                             line-height="20px">
                        <p>Votre reçu de Mathrix</p>
                    </mj-text>
                    <mj-text height="16"
                             padding="0"
                             align="center"
                             font-size="14px">
                        <p>Référence {{ strtoupper($transaction->id) }}</p>
                    </mj-text>

                </mj-column>
            </mj-section>

            <mj-include path="../common/transactionBody"></mj-include>

            <mj-include path="../common/support"></mj-include>
            <mj-include path="../common/footer"></mj-include>
        </mj-container>
    </mj-body>
</mjml>
