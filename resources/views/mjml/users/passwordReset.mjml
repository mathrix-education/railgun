<mjml>
    <mj-include path="../common/head"></mj-include>

    <mj-body>
        <mj-container>
            <mj-include path="../common/header"></mj-include>

            <mj-section background-color="#ffffff">
                <mj-column>
                    <mj-text font-size="18px">Salut {{ $firstname }} !</mj-text>
                    <mj-text>Ton mot passe a été modifié avec succès ! Tu peux maintenant te connecter ici :</mj-text>

                    <mj-button href="{{ $webroot }}/connexion/">
                        Connexion à Mathrix.fr
                    </mj-button>

                    <mj-divider border-width="1px" border-style="dashed" border-color="lightgrey"></mj-divider>

                    <mj-text color="#9d9d9d" padding="15px 40px 25px 40px">
                        Si tu n’as pas demandé de réinitialisation, contacte-nous vite à <a
                                href="mailto:contact@mathrix.fr">contact@mathrix.fr</a>
                    </mj-text>
                </mj-column>
            </mj-section>

            <mj-include path="../common/footer"></mj-include>
        </mj-container>
    </mj-body>
</mjml>
