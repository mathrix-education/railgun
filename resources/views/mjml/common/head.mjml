<mj-head>
    <mj-attributes>
        <mj-text line-height="1.4"></mj-text>
        <mj-button font-size="18px"
                   line-height="2"
                   background-color="#3c8d80"
                   border-radius="50px"></mj-button>
    </mj-attributes>

    <mj-style>
        a {
        color: #3c8d80;
        text-decoration: none;
        }
    </mj-style>
</mj-head>
