<mjml>
    <mj-include path="common/head.mjml"></mj-include>

    <mj-body>
        <mj-include path="common/header.mjml"></mj-include>

        <mj-section background-color="#ffffff">
            <mj-column>
                <mj-text height="20px"
                         padding="0"
                         align="center"
                         font-size="18px"
                         line-height="20px">
                    <p>Votre reçu de Mathrix</p>
                </mj-text>

                <mj-text height="16px"
                         padding="0"
                         align="center"
                         font-size="14px">
                    <p>Référence {{ strtoupper($transaction->id) }}</p>
                </mj-text>

            </mj-column>
        </mj-section>

        <mj-include path="common/transaction_body.mjml"></mj-include>

        <mj-include path="common/support.mjml"></mj-include>
        <mj-include path="common/footer.mjml"></mj-include>
    </mj-body>
</mjml>
