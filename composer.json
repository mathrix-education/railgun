{
  "name": "mathrix/mathrix-api",
  "description": "The Mathrix API server",
  "version": "4.2.0",
  "license": "proprietary",
  "type": "project",
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": ">=7.1",
    "ext-json": "*",
    "ext-zip": "*",
    "barryvdh/laravel-cors": "^0.11",
    "braintree/braintree_php": "^3.35",
    "drewm/mailchimp-api": "^2.5",
    "dusterio/lumen-passport": "^0.2.0",
    "fzaninotto/faker": "~1.4",
    "guzzlehttp/guzzle": "^6.3",
    "illuminate/mail": "^5.7",
    "illuminate/notifications": "^5.7",
    "illuminate/redis": "^5.7",
    "illuminate/routing": "^5.7",
    "laravel/lumen-framework": "5.7.*",
    "laravel/passport": "^4.0",
    "league/flysystem": " ~1.0",
    "nao-pon/flysystem-google-drive": "^1.1",
    "paulvl/backup": "3.*",
    "ramsey/uuid": "^3.8",
    "roumen/sitemap": "^2.8",
    "sentry/sentry-laravel": "^0.8.0",
    "spatie/laravel-newsletter": "^4.1",
    "stripe/stripe-php": "^6.15",
    "tinify/tinify": "^1.5",
    "vlucas/phpdotenv": "~2.2"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^2.4",
    "brianium/paratest": "^2.0",
    "doctrine/dbal": "^2.5",
    "friendsofphp/php-cs-fixer": "^2.13",
    "helmich/phpunit-json-assert": "^2.0",
    "mockery/mockery": "~0.9",
    "phpunit/phpunit": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "classmap": [
      "database/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
