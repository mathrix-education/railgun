{
  "name": "mathrix/server",
  "description": "The Mathrix API server",
  "keywords": [
    "framework",
    "laravel",
    "lumen"
  ],
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=7.1",
    "laravel/lumen-framework": "5.4.*",
    "vlucas/phpdotenv": "~2.2",
    "dusterio/lumen-passport": "^0.2.0",
    "barryvdh/laravel-cors": "^0.9.2",
    "mmghv/lumen-route-binding": "1.3.0"
  },
  "require-dev": {
    "fzaninotto/faker": "~1.4",
    "phpunit/phpunit": "~5.0",
    "mockery/mockery": "~0.9",
    "barryvdh/laravel-ide-helper": "^2.4",
    "doctrine/dbal": "^2.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    },
    "classmap": [
      "tests/",
      "database/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
