{
  "name": "mathrix/education-api",
  "description": "The Mathrix Education Lumen API.",
  "version": "6.0.0",
  "type": "project",
  "keywords": [
    "education",
    "mathrix",
    "php",
    "lumen"
  ],
  "homepage": "https://api.mathrix.fr",
  "license": "proprietary",
  "authors": [
    {
      "name": "Mathieu Bour",
      "email": "mathieu@mathrix.fr",
      "homepage": "https://www.linkedin.com/in/mathieu-bour",
      "role": "Maintainer"
    }
  ],
  "support": {
    "email": "mathieu@mathrix.fr",
    "issues": "https://github.com/mathrix-education/education-api/issues",
    "wiki": "https://github.com/mathrix-education/education-api/wiki",
    "source": "https://github.com/mathrix-education/education-api",
    "docs": "https://mathrix.fr/api/docs"
  },
  "require": {
    "php": ">=7.2",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-zip": "*",
    "barryvdh/laravel-cors": "v0.11.3",
    "braintree/braintree_php": "3.40",
    "facebook/graph-sdk": "^5.7",
    "fzaninotto/faker": "v1.8.0",
    "google/cloud-kms": "^1.7",
    "guzzlehttp/guzzle": "6.3.3",
    "laravel/lumen-framework": "5.8.10",
    "league/flysystem": " 1.0.53",
    "mathrix/lumen-chainer": "1.2.0",
    "mathrix/lumen-jwt-auth": "1.2.0",
    "mathrix/lumen-zero": "2.4.1",
    "ramsey/uuid": "3.8.0",
    "sentry/sentry-laravel": "1.1.0",
    "spatie/laravel-sitemap": "^5.4",
    "stripe/stripe-php": "^6.43",
    "superbalist/laravel-google-cloud-storage": "^2.2",
    "vlucas/phpdotenv": "v3.4.0"
  },
  "require-dev": {
    "brianium/paratest": "3.0.0",
    "doctrine/dbal": "2.9.2",
    "league/csv": "^9.2",
    "mathrix/openapi-assertions": "0.10.1",
    "mathrix/openapi-processor": "0.9.7",
    "mockery/mockery": "1.2.2",
    "nyholm/psr7": "^1.1",
    "phpunit/phpunit": "8.2.4",
    "symfony/psr-http-message-bridge": "^1.2",
    "symfony/yaml": "4.2.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "classmap": [
      "database/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:mathrix-education/lumen-chainer.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:mathrix-education/lumen-jwt-auth.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:mathrix-education/lumen-zero.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:mathrix-education/openapi-assertions.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:mathrix-education/openapi-processor.git"
    }
  ],
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "compile:docs": "openapi-processor --input=docs/index.yaml"
  }
}
