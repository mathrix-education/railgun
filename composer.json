{
  "name": "mathrix-education/railgun",
  "description": "The Mathrix Education Lumen API.",
  "version": "7.0.0",
  "type": "project",
  "keywords": [
    "education",
    "mathrix",
    "php",
    "lumen"
  ],
  "homepage": "https://api.mathrix.fr",
  "license": "proprietary",
  "authors": [
    {
      "name": "Mathieu Bour",
      "email": "mathieu@mathrix.fr",
      "homepage": "https://www.linkedin.com/in/mathieu-bour",
      "role": "Maintainer"
    }
  ],
  "support": {
    "email": "mathieu@mathrix.fr",
    "issues": "https://github.com/mathrix-education/education-api/issues",
    "source": "https://github.com/mathrix-education/education-api",
    "docs": "https://api.mathrix.fr"
  },
  "require": {
    "php": ">=7.4",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-simplexml": "*",
    "ext-zip": "*",
    "braintree/braintree_php": "^4.6",
    "google/cloud-kms": "v1.7.0",
    "guzzlehttp/guzzle": "6.3.3",
    "illuminate/redis": "^6.12",
    "laravel/lumen-framework": "^6.0",
    "mathrix-education/lumen-jwt": "3.0.0-alpha.6",
    "mll-lab/laravel-graphql-playground": "^2.0",
    "nuwave/lighthouse": "^4.8",
    "ramsey/uuid": "3.8.0",
    "sentry/sentry-laravel": "1.5.0",
    "stripe/stripe-php": "^7.17.0",
    "vlucas/phpdotenv": "3.6.0",
    "web-token/jwt-signature-algorithm-eddsa": "^2.1"
  },
  "require-dev": {
    "doctrine/dbal": "2.9.2",
    "fzaninotto/faker": "1.9.1",
    "haydenpierce/class-finder": "^0.4.0",
    "mathrix-education/coding-standard": "1.0.0",
    "mockery/mockery": "1.2.2",
    "nyholm/psr7": "1.2.1",
    "phpunit/phpunit": "^8.2",
    "squizlabs/php_codesniffer": "3.5.3",
    "symfony/psr-http-message-bridge": "1.2.0",
    "symfony/yaml": "4.2.8"
  },
  "autoload": {
    "psr-4": {
      "Railgun\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "classmap": [
      "database/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "post-install-cmd": [
      "[ $COMPOSER_DEV_MODE -eq 0 ] || bin/artisan lighthouse:ide-helper"
    ],
    "post-update-cmd": [
      "[ $COMPOSER_DEV_MODE -eq 0 ] || bin/artisan lighthouse:ide-helper"
    ],
    "test": "phpunit",
    "test:cover": "phpunit --testdox --log-junit=storage/artifacts/phpunit-junit.xml --coverage-clover=storage/artifacts/phpunit-coverage.xml --coverage-text",
    "lint": "phpcs --report=source",
    "lint:details": "phpcs",
    "lint:fix": "phpcbf"
  }
}
