{
  "name": "mathrix-education/railgun",
  "description": "Railgun-fast paced GraphQL API for Mathrix Education.",
  "version": "14.1.0",
  "type": "project",
  "keywords": [
    "education",
    "mathrix",
    "graphql",
    "laravel",
    "lumen",
    "api"
  ],
  "homepage": "https://github.com/mathrix-education/railgun",
  "license": "proprietary",
  "authors": [
    {
      "name": "Mathieu Bour",
      "email": "mathieu@mathrix.fr",
      "homepage": "https://github.com/mathieu-bour",
      "role": "Maintainer"
    },
    {
      "name": "Valentin Pollart",
      "email": "valentin@mathrix.fr",
      "homepage": "https://github.com/valentinpollart",
      "role": "Contributor"
    },
    {
      "name": "Dimitri Bret",
      "email": "dimitri@mathrix.fr",
      "homepage": "https://github.com/dimitri-bret",
      "role": "Contributor"
    }
  ],
  "support": {
    "email": "mathieu@mathrix.fr",
    "issues": "https://github.com/mathrix-education/railgun/issues",
    "source": "https://github.com/mathrix-education/railgun",
    "docs": "https://github.com/mathrix-education/railgun"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/lumen-healthz"
    },
    {
      "type": "path",
      "url": "packages/lumen-prometheus-exporter"
    }
  ],
  "require": {
    "php": ">=7.4",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-pcntl": "*",
    "ext-redis": "*",
    "ext-simplexml": "*",
    "ext-zip": "*",
    "braintree/braintree_php": "^5.2",
    "doctrine/dbal": "^2.10",
    "facebook/graph-sdk": "^5.7",
    "fruitcake/laravel-cors": "^2.0",
    "google/apiclient": "^2.4",
    "guzzlehttp/guzzle": "^6.3.3",
    "haydenpierce/class-finder": "^0.4.0",
    "illuminate/notifications": "^7.0",
    "illuminate/redis": "^7.0",
    "laravel/lumen-framework": "^7.0",
    "mathieu-bour/guardian": "^0.1.0",
    "mathieu-bour/laravel-cache-fallback": "dev-master",
    "mathieu-bour/laravel-mailjet": "^1.0",
    "mathrix-education/lumen-healthz": "^0.1.0",
    "mathrix-education/lumen-prometheus-exporter": "^0.1",
    "mll-lab/graphql-php-scalars": "^4.0",
    "mll-lab/laravel-graphql-playground": "^2.0",
    "nuwave/lighthouse": "^4.8",
    "php-pm/httpkernel-adapter": "^2.0",
    "php-pm/php-pm": "^2.0",
    "psr/log": "^1.1",
    "sentry/sentry-laravel": "^1.6",
    "stripe/stripe-php": "^7.17.0",
    "superbalist/laravel-google-cloud-storage": "^2.2",
    "symfony/polyfill-uuid": "^1.15",
    "symfony/yaml": "^5.0",
    "thepixeldeveloper/sitemap": "^5.1",
    "web-token/jwt-signature-algorithm-eddsa": "^2.1",
    "web-token/jwt-signature-algorithm-hmac": "^2.1"
  },
  "require-dev": {
    "brianium/paratest": "^4.0",
    "fzaninotto/faker": "^1.9.1",
    "laravel/tinker": "^2.2",
    "mathrix-education/coding-standard": "^2.0",
    "mockery/mockery": "^1.3",
    "phpunit/phpunit": "^9.0",
    "roave/security-advisories": "dev-master",
    "squizlabs/php_codesniffer": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "Railgun\\": "app/"
    },
    "files": [
      "app/helpers.php",
      "resources/lang/fr/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "classmap": [
      "database/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
