{
  "name": "mathrix/mathrix-api",
  "description": "The Mathrix API server",
  "version": "4.0.4",
  "license": "proprietary",
  "type": "project",
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": ">=7.1",
    "ext-zip": "*",
    "ext-json": "*",
    "barryvdh/laravel-cors": "^0.11",
    "drewm/mailchimp-api": "^2.5",
    "dusterio/lumen-passport": "^0.2.0",
    "fzaninotto/faker": "~1.4",
    "illuminate/mail": "^5.6",
    "illuminate/redis": "^5.6",
    "illuminate/routing": "^5.6",
    "laravel/cashier": "~7.0",
    "laravel/lumen-framework": "5.6.*",
    "laravel/passport": "^6.0",
    "league/flysystem": " ~1.0",
    "nao-pon/flysystem-google-drive": "^1.1",
    "paulvl/backup": "3.*",
    "roumen/sitemap": "^2.8",
    "sentry/sentry-laravel": "^0.8.0",
    "spatie/laravel-newsletter": "^4.1",
    "tinify/tinify": "^1.5",
    "vlucas/phpdotenv": "~2.2"
  },
  "require-dev": {
    "mockery/mockery": "~0.9",
    "barryvdh/laravel-ide-helper": "^2.4",
    "doctrine/dbal": "^2.5",
    "filp/whoops": "~2.0",
    "phpunit/phpunit": "^7.0",
    "brianium/paratest": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "classmap": [
      "database/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
