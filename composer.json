{
  "name": "mathrix/education-api",
  "description": "The Mathrix Education Lumen API.",
  "version": "5.1.2",
  "type": "project",
  "keywords": [
    "education",
    "mathrix",
    "php",
    "lumen"
  ],
  "homepage": "https://mathrix.fr/api",
  "license": "proprietary",
  "authors": [
    {
      "name": "Mathieu Bour",
      "email": "mathieu@mathrix.fr",
      "homepage": "https://www.linkedin.com/in/mathieu-bour",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "mathieu@mathrix.fr",
    "issues": "https://github.com/mathrix-education/education-api/issues",
    "wiki": "https://github.com/mathrix-education/education-api/wiki",
    "source": "https://github.com/mathrix-education/education-api",
    "docs": "https://mathrix.fr/api/docs"
  },
  "require": {
    "php": ">=7.2",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-zip": "*",
    "barryvdh/laravel-cors": "v0.11.3",
    "braintree/braintree_php": "3.40",
    "codeinternetapplications/monolog-stackdriver": "1.2.1",
    "facebook/graph-sdk": "^5.7",
    "fzaninotto/faker": "v1.8.0",
    "guzzlehttp/guzzle": "6.3.3",
    "illuminate/mail": "5.7.28",
    "illuminate/notifications": "5.7.28",
    "illuminate/routing": "5.7.28",
    "laravel/lumen-framework": "5.7.8",
    "laravelium/sitemap": "3.0.1",
    "league/flysystem": " 1.0.51",
    "mathrix/lumen-chainer": "1.1.0",
    "mathrix/lumen-jwt-auth": "1.1.10",
    "mathrix/lumen-zero": "1.1.7",
    "ramsey/uuid": "3.8.0",
    "sentry/sentry-laravel": "1.0.2",
    "stripe/stripe-php": "6.34.3",
    "superbalist/laravel-google-cloud-storage": "2.2.1",
    "vlucas/phpdotenv": "2.6.1"
  },
  "require-dev": {
    "brianium/paratest": "2.2.0",
    "doctrine/dbal": "2.9.2",
    "mockery/mockery": "1.2.2",
    "nyholm/psr7": "1.1.0",
    "phpunit/phpunit": "7.5.9",
    "rebilly/openapi-php": "0.6.0",
    "symfony/psr-http-message-bridge": "1.2.0",
    "symfony/yaml": "4.2.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "classmap": [
      "database/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:mathrix-education/lumen-chainer.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:mathrix-education/lumen-jwt-auth.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:mathrix-education/lumen-zero.git"
    }
  ],
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
