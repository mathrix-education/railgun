{
  "name": "mathrix-education/education-api",
  "description": "The Mathrix Education Lumen API.",
  "version": "7.0.0",
  "type": "project",
  "keywords": [
    "education",
    "mathrix",
    "php",
    "lumen"
  ],
  "homepage": "https://api.mathrix.fr",
  "license": "proprietary",
  "authors": [
    {
      "name": "Mathieu Bour",
      "email": "mathieu@mathrix.fr",
      "homepage": "https://www.linkedin.com/in/mathieu-bour",
      "role": "Maintainer"
    }
  ],
  "support": {
    "email": "mathieu@mathrix.fr",
    "issues": "https://github.com/mathrix-education/education-api/issues",
    "source": "https://github.com/mathrix-education/education-api",
    "docs": "https://api.mathrix.fr"
  },
  "require": {
    "php": ">=7.4",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-simplexml": "*",
    "ext-zip": "*",
    "fruitcake/laravel-cors": "1.0.3",
    "braintree/braintree_php": "4.5.0",
    "facebook/graph-sdk": "5.7.0",
    "fzaninotto/faker": "1.9.1",
    "google/cloud-kms": "v1.7.0",
    "guzzlehttp/guzzle": "6.3.3",
    "laravel/lumen-framework": "^6.0",
    "league/flysystem": " 1.0.53",
    "mathrix-education/lumen-jwt-auth": "2.0.0-beta.2",
    "mathrix-education/lumen-zero": "3.0.0-beta.10",
    "ramsey/uuid": "3.8.0",
    "sentry/sentry-laravel": "1.5.0",
    "stripe/stripe-php": "7.17.0",
    "superbalist/laravel-google-cloud-storage": "2.2.2",
    "thepixeldeveloper/sitemap": "5.1.3",
    "vlucas/phpdotenv": "3.6.0"
  },
  "require-dev": {
    "bentools/cartesian-product": "1.3",
    "doctrine/dbal": "2.9.2",
    "mathrix-education/coding-standard": "1.0.0",
    "mathrix-education/openapi-assertions": "1.0.0",
    "mathrix-education/openapi-processor": "2.0.0",
    "mockery/mockery": "1.2.2",
    "nyholm/psr7": "1.2.1",
    "phpunit/phpunit": "8.2.4",
    "squizlabs/php_codesniffer": "3.5.3",
    "symfony/psr-http-message-bridge": "1.2.0",
    "symfony/yaml": "4.2.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "classmap": [
      "database/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit",
    "test:cover": "phpunit --log-junit=storage/artifacts/phpunit-junit.xml --coverage-clover=storage/artifacts/phpunit-coverage.xml --coverage-text",
    "docs:compile": "openapi-processor --input=docs/index.yaml --config=docs/config.yaml",
    "lint": "phpcs --report=source",
    "lint:details": "phpcs",
    "lint:fix": "phpcbf"
  }
}
