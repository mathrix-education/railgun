{
  "name": "mathrix/server",
  "description": "The Mathrix API server",
  "keywords": [
    "framework",
    "laravel",
    "lumen"
  ],
  "license": "proprietary",
  "type": "project",
  "repositories": [
    {
      "type": "git",
      "url": "git@gitlab.com:mathrix/lumen-utils.git"
    }
  ],
  "require": {
    "php": ">=7.1",
    "laravel/lumen-framework": "5.4.*",
    "vlucas/phpdotenv": "~2.2",
    "dusterio/lumen-passport": "^0.2.0",
    "barryvdh/laravel-cors": "^0.9.2",
    "mathrix/lumen-utils": "dev-master",
    "illuminate/mail": "^5.4",
    "guzzlehttp/guzzle": "^6.3"
  },
  "require-dev": {
    "fzaninotto/faker": "~1.4",
    "phpunit/phpunit": "~5.0",
    "mockery/mockery": "~0.9",
    "barryvdh/laravel-ide-helper": "^2.4",
    "doctrine/dbal": "^2.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    },
    "classmap": [
      "tests/",
      "database/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
