{
  "name": "mathrix/mathrix-api",
  "description": "The Mathrix API server",
  "version": "4.0.3",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=7.1",
    "laravel/lumen-framework": "5.6.*",
    "laravel/passport": "^6.0",
    "vlucas/phpdotenv": "~2.2",
    "dusterio/lumen-passport": "^0.2.0",
    "illuminate/mail": "^5.4",
    "laravel/cashier": "~7.0",
    "barryvdh/laravel-cors": "^0.11",
    "illuminate/routing": "^5.5",
    "spatie/laravel-newsletter": "^4.1",
    "sentry/sentry-laravel": "^0.8.0",
    "league/flysystem": " ~1.0",
    "roumen/sitemap": "^2.8",
    "paulvl/backup": "3.*",
    "nao-pon/flysystem-google-drive": "^1.1",
    "fzaninotto/faker": "~1.4"
  },
  "require-dev": {
    "mockery/mockery": "~0.9",
    "barryvdh/laravel-ide-helper": "^2.4",
    "doctrine/dbal": "^2.5",
    "filp/whoops": "~2.0",
    "laravel/envoy": "^1.4",
    "phpunit/phpunit": "^7.0",
    "brianium/paratest": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "classmap": [
      "database/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
