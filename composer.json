{
  "name": "mathrix/education-api",
  "description": "The Mathrix Education Lumen API.",
  "version": "5.0.0",
  "type": "project",
  "keywords": [
    "education",
    "mathrix",
    "php",
    "lumen"
  ],
  "homepage": "https://mathrix.fr/api",
  "license": "proprietary",
  "authors": [
    {
      "name": "Mathieu Bour",
      "email": "mathieu@mathrix.fr",
      "homepage": "https://www.linkedin.com/in/mathieu-bour",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "mathieu@mathrix.fr",
    "issues": "https://github.com/mathrix-education/education-api/issues",
    "wiki": "https://github.com/mathrix-education/education-api/wiki",
    "source": "https://github.com/mathrix-education/education-api",
    "docs": "https://mathrix.fr/api/docs"
  },
  "require": {
    "php": ">=7.2",
    "ext-json": "*",
    "ext-zip": "*",
    "barryvdh/laravel-cors": "^0.11",
    "braintree/braintree_php": "^3.37",
    "dusterio/lumen-passport": "^0.2.0",
    "fzaninotto/faker": "~1.4",
    "guzzlehttp/guzzle": "^6.3",
    "illuminate/mail": "^5.7",
    "illuminate/notifications": "^5.7",
    "illuminate/routing": "^5.7",
    "laravel/lumen-framework": "5.7.*",
    "laravel/passport": "^7.0",
    "laravelium/sitemap": "^3.0",
    "league/flysystem": " ~1.0",
    "mathrix/lumen-chainer": "dev-master",
    "mathrix/lumen-zero": "dev-master",
    "ramsey/uuid": "^3.8",
    "sentry/sentry-laravel": "^0.8.0",
    "stripe/stripe-php": "^6.15",
    "superbalist/laravel-google-cloud-storage": "^2.1",
    "vlucas/phpdotenv": "~2.2",
    "zendframework/zend-diactoros": "~1.0"
  },
  "require-dev": {
    "brianium/paratest": "^2.0",
    "doctrine/dbal": "^2.5",
    "helmich/phpunit-json-assert": "^2.0",
    "mockery/mockery": "~1.0",
    "phpunit/phpunit": "^7.0",
    "symfony/yaml": "^4.2",
    "vluzrmos/tinker": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "classmap": [
      "database/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "git",
      "url": "git@github.com:mathrix-education/lumen-zero.git"
    },
    {
      "type": "git",
      "url": "git@github.com:mathrix-education/lumen-chainer.git"
    }
  ],
  "config": {
    "sort-packages": true
  }
}
