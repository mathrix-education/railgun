#!/usr/bin/env node
/**
 * Small script to generate CI values.
 */
const {readFileSync} = require('fs');
const {execSync} = require('child_process');

// Constants
const versionFile = 'composer.json';
const dockerImage = 'eu.gcr.io/mathrix-education/education-api'

function usage() {
  console.log('Usage: mapping.js [command]');
  process.exit(1);
}

function print(str) {
  process.stdout.write(`${str}`);
}

function exec(command) {
  return execSync(command).toString().trim();
}

function version() {
  return JSON.parse(readFileSync(`${__dirname}/${versionFile}`).toString()).version;
}

function ref() {
  return process.env.GITHUB_REF ? process.env.GITHUB_REF : exec('git symbolic-ref HEAD');
}

function branch() {
  return ref().replace('refs/heads/', '');
}

function env() {
  if (['stage', 'production'].includes(branch())) {
    return branch();
  } else {
    return 'edge';
  }
}

function sha(length = 7) {
  return exec('git rev-parse HEAD').substr(0, length);
}

function buildNumber() {
  return process.env.GITHUB_RUN_NUMBER ? process.env.GITHUB_RUN_NUMBER : '0';
}

function slug(str) {
  return str.replace(/\/#/g, '-');
}

function semver() {
  return `${version()}+${buildNumber()}.${slug(branch())}.${sha()}`;
}

function dockerTag() {
  return `${version()}-${buildNumber()}.${slug(branch())}.${sha()}`;
}

// Parse argv
const argv = JSON.parse(JSON.stringify(process.argv));
argv.splice(0, 2);

if (!argv[0] || ['-h', '--help', 'help'].includes(argv[0])) {
  usage();
}

switch (argv[0]) {
  case 'v':
  case 'version':
    print(version());
    break;
  case 'semver':
  case 'sv':
    print(semver());
    break;
  case 'env':
  case 'environment':
  case 'ns':
  case 'namespace':
    print(env());
    break;
  case 'docker':
    switch (argv[1]) {
      case 'latest':
        print(`${dockerImage}:latest-${env()}`);
        break;
      default:
        print(`${dockerImage}:${dockerTag()}`);
        break;
    }
    break;
  default:
    usage();
    break;
}
